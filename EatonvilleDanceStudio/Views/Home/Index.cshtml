@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <!-- Hero Section: The main visual hook for the site -->
    <div class="p-5 mb-4 bg-transparent rounded-3 border hero-border">
        <div class="container-fluid py-5">
            <!-- Added text-neon to make the studio name glow -->
            <h1 class="display-5 fw-bold text-neon">Eatonville Dance Studio</h1>
            <p class="col-md-8 fs-4 mx-auto text-light">Discover your passion for dance. We offer classes for all ages and skill levels.</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container">
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-3">
            
            <!-- Card 1 -->
            <div class="col">
                <div class="card bg-dark text-white border-neon h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <h4 class="card-title text-neon mb-3">Dance Classes</h4>
                        <p class="card-text text-light flex-grow-1">
                            Explore our youth and adult class schedules from hip-hop to classical ballet.
                        </p>
                        <div class="mt-3">
                            <button id="danceClass" type="submit" class="w-100 btn btn-neon">See Classes</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col">
                <div class="card bg-dark text-white border-neon h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <h4 class="card-title text-neon mb-3">Private Lessons</h4>
                        <p class="card-text text-light flex-grow-1">
                            One-on-one sessions tailored for competition prep and technique building.
                        </p>
                        <div class="mt-3">
                            <button id="privateLessonSubmit" type="submit" class="w-100 btn btn-neon">See Pricing</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="col">
                <div class="card bg-dark text-white border-neon h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <h4 class="card-title text-neon mb-3">Studio Rentals</h4>
                        <p class="card-text text-light flex-grow-1">
                            Rent our open floor spaces for rehearsals, choreography, or private events.
                        </p>
                        <div class="mt-3">
                            <button id="rentalSubmit" type="submit" class="w-100 btn btn-neon">Rentals</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>