@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <!-- Hero Section: The main visual hook for the site -->
    <div class="p-5 mb-4 bg-transparent rounded-3 border border-secondary shadow-sm">
        <div class="container-fluid py-5">
            <!-- Added text-neon to make the studio name glow -->
            <h1 class="display-5 fw-bold text-neon">Eatonville Dance Studio</h1>
            <p class="col-md-8 fs-4 mx-auto text-light">Discover your passion for dance. We offer classes for all ages and skill levels.</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container">
        <div class="row">

            <!-- Studio Information -->
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title">About Us</h2>
                        <p class="card-text">Located in the heart of the community, we provide a welcoming environment to learn, grow, and perform. From ballet to hip-hop, our experienced instructors are here to guide you.</p>
                    </div>
                </div>
            </div>

            <!-- Class Schedules -->
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title">Schedules</h2>
                        <p class="card-text">Check out our fall lineup! We have afternoon and evening sessions available throughout the week to fit your busy schedule.</p>
                        <a href="#" class="btn btn-primary">View Full Schedule</a>
                    </div>
                </div>
            </div>

            <!-- Contact Details -->
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title">Contact</h2>
                        <p class="card-text">
                            <strong>Phone:</strong> (360) 832-5555<br />
                            <strong>Email:</strong> eatonville_dancecenter@yahoo.com<br />
                            <strong>Address:</strong> 131 mashell ave N. Eatonville, WA. 98328
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>