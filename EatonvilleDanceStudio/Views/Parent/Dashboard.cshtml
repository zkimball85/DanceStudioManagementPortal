@model EatonvilleDanceStudio.Models.ParentProfile
@{
    ViewData["Title"] = "Parent Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-neon">Household Dashboard</h2>
        <div>
            <span class="text-light me-3">Account Status: 
                <span class="badge @(Model.AccountStatus == "Approved" ? "bg-success" : "bg-warning text-dark")">
                    @Model.AccountStatus
                </span>
            </span>
        </div>
    </div>

    <div class="row">
        <!-- Parent Info Card -->
        <div class="col-md-4 mb-4">
            <div class="card card-neon bg-dark text-light border-0">
                <div class="card-body">
                    <h5 class="card-title text-neon border-bottom border-secondary pb-2">Primary Contact</h5>
                    <p class="mb-1"><strong>Name:</strong> @Model.FirstName @Model.LastName</p>
                    <p class="mb-1"><strong>Phone:</strong> @Model.PrimaryPhone</p>
                    <hr class="border-secondary" />
                    <h6 class="text-muted">Emergency Contact</h6>
                    <p class="mb-1"><strong>Name:</strong> @Model.EmergencyContactName</p>
                    <p class="mb-0"><strong>Phone:</strong> @Model.EmergencyContactPhone</p>
                </div>
            </div>
        </div>

        <!-- Dancers Roster -->
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="text-light">Registered Dancers</h4>
                <a asp-action="AddDancer" class="btn btn-outline-success">+ Add Dancer</a>
            </div>

            @if (Model.Dancers.Any())
            {
                <div class="row">
                    @foreach (var dancer in Model.Dancers)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card bg-dark text-light border-secondary">
                                <div class="card-body">
                                    <h5 class="card-title text-neon">@dancer.FirstName @dancer.LastName</h5>
                                    <p class="mb-1"><strong>DOB:</strong> @dancer.DateOfBirth?.ToString("MMMM dd, yyyy")</p>
                                    <p class="mb-1"><strong>Skill Level:</strong> @dancer.SkillLevel</p>
                                    
                                    <div class="mt-3">
                                        <a asp-action="EditDancer" asp-route-id="@dancer.Id" class="btn btn-sm btn-outline-primary">Edit / Upload Photo</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-secondary bg-dark text-light border-secondary">
                    You haven't added any dancers yet. Click the button above to get started!
                </div>
            }
        </div>
    </div>
</div>