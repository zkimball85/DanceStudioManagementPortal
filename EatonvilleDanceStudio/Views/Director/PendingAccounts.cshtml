@model IEnumerable<EatonvilleDanceStudio.Models.ParentProfile>
@{
    ViewData["Title"] = "Pending Approvals";
}

<h2 class="text-neon mt-4 mb-4">Pending Account Approvals</h2>

<div class="table-responsive">
    <table class="table table-dark table-hover box-shadow">
        <thead>
        <tr>
            <th class="text-neon">Parent Name</th>
            <th class="text-neon">Primary Phone</th>
            <th class="text-neon">Emergency Contact</th>
            <th class="text-neon">Status</th>
            <th class="text-neon">Action</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle">@item.FirstName @item.LastName</td>
                <td class="align-middle">@item.PrimaryPhone</td>
                <td class="align-middle">@item.EmergencyContactName (@item.EmergencyContactPhone)</td>
                <td class="align-middle">
                    <span class="badge bg-warning text-dark">@item.AccountStatus</span>
                </td>
                <td class="align-middle">
                    <form asp-action="Approve" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                    </form>
                </td>
            </tr>
        }
            
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">No pending accounts found. You're all caught up!</td>
            </tr>
        }
        </tbody>
    </table>
</div>