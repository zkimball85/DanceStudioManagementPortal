@model EatonvilleDanceStudio.ViewModels.ClassRosterViewModel

@{
    ViewData["Title"] = Model.DanceClass.ClassName + " - Roster";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-neon mb-0">@Model.DanceClass.ClassName</h1>
            <p class="text-light mb-0">@Model.DanceClass.DayOfWeek @@ @Model.DanceClass.StartTime.ToString(@"hh\:mm")</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-light">Back to Dashboard</a>
    </div>

    <div class="card card-dark shadow-lg border-secondary">
        <div class="card-header border-secondary bg-transparent d-flex justify-content-between align-items-center">
            <h4 class="text-neon mb-0">Attendance Tracker</h4>
            <span class="badge bg-secondary text-light fs-6">Date: @Model.ClassDate.ToShortDateString()</span>
        </div>
        <div class="card-body p-0">
            <form asp-action="SubmitAttendance" method="post">
                
                <!-- Hidden fields to pass the main class info back to the POST method -->
                <input type="hidden" asp-for="DanceClass.Id" />
                <input type="hidden" asp-for="ClassDate" />

                @if (!Model.AttendanceList.Any())
                {
                    <div class="p-4 text-center">
                        <p class="text-light mb-0">No dancers are currently enrolled in this class.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead>
                                <tr class="border-secondary">
                                    <th class="text-neon ps-4">Dancer</th>
                                    <th class="text-neon">Status</th>
                                    <th class="text-neon pe-4">Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.AttendanceList.Count; i++)
                                {
                                    <tr class="border-secondary">
                                        <td class="ps-4">
                                            <!-- Hidden fields to keep track of the specific record we are updating/adding -->
                                            <input type="hidden" asp-for="AttendanceList[i].Id" />
                                            <input type="hidden" asp-for="AttendanceList[i].EnrollmentId" />
                                            <input type="hidden" asp-for="AttendanceList[i].Date" />
                                            
                                            <strong>@Model.AttendanceList[i].Enrollment?.Dancer?.FirstName @Model.AttendanceList[i].Enrollment?.Dancer?.LastName</strong>
                                        </td>
                                        <td>
                                            <select asp-for="AttendanceList[i].Status" class="form-select bg-dark text-light border-secondary">
                                                <option value="Present">Present</option>
                                                <option value="Absent">Absent</option>
                                                <option value="Excused">Excused</option>
                                                <option value="Tardy">Tardy</option>
                                            </select>
                                        </td>
                                        <td class="pe-4">
                                            <input asp-for="AttendanceList[i].Notes" class="form-control bg-dark text-light border-secondary" placeholder="Optional notes (e.g., Left early)..." />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="p-3 bg-black border-top border-secondary text-end">
                        <button type="submit" class="btn btn-neon btn-lg">Save Attendance</button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>